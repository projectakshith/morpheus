{
  "name": "morpheus",
  "version": "0.1.0",
  "description": "Agentic coding harness inspired by The Matrix",
  "type": "module",
  "bin": {
    "morpheus": "./bin/morpheus.ts"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx bin/morpheus.ts",
    "test": "tsx --test test/tools.test.ts",
    "build": "tsc",
